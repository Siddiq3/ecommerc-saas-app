# Only EXPO_PUBLIC_* variables reach the app bundle. Nothing secret belongs here:
# anything in this file ships inside the APK and can be read by anyone who unzips it.

# The API. No trailing slash.
EXPO_PUBLIC_API_URL=http://localhost:3001

# Used to build the merchant's own storefront link and the help/terms links.
EXPO_PUBLIC_STOREFRONT_HOST=storekit.site
