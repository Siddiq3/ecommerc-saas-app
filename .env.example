# Only EXPO_PUBLIC_* variables reach the app bundle. Nothing secret belongs here:
# anything in this file ships inside the APK and can be read by anyone who unzips it.

# The API. No trailing slash.
EXPO_PUBLIC_API_URL=http://localhost:3001

# The storefront ROOT. Every store is served at {slug}.<this host>, so this is what
# https://asha-boutique.storekit.site is built from. Keep it identical to the API's
# STOREFRONT_BASE_URL. Local: http://lvh.me:3000 (*.localhost does not resolve reliably).
EXPO_PUBLIC_STOREFRONT_URL=https://storekit.site

# The marketing website, used only for the help, terms and privacy links. Not a store address.
EXPO_PUBLIC_STOREFRONT_HOST=storekit.site
