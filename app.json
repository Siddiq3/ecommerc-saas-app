{
  "expo": {
    "name": "StoreFlick",
    "slug": "storeflick",
    "platforms": [
      "ios",
      "android"
    ],
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "storeflick",
    "assetBundlePatterns": [
      "**/*"
    ],
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "in.storeflick.owner",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "in.storeflick.owner",
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "com.google.android.gms.permission.AD_ID",
        "android.permission.WRITE_CONTACTS"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "StoreFlick uses your photos so you can add pictures of your products.",
          "cameraPermission": "StoreFlick uses your camera to photograph your products and to scan barcodes and QR codes when you make a bill.",
          "microphonePermission": "StoreFlick uses the microphone only when you tap the mic button, so you can type with your voice."
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/ionicons.ttf",
            "./node_modules/@expo-google-fonts/urbanist/600SemiBold/Urbanist_600SemiBold.ttf",
            "./node_modules/@expo-google-fonts/urbanist/700Bold/Urbanist_700Bold.ttf",
            "./node_modules/@expo-google-fonts/plus-jakarta-sans/400Regular/PlusJakartaSans_400Regular.ttf",
            "./node_modules/@expo-google-fonts/plus-jakarta-sans/500Medium/PlusJakartaSans_500Medium.ttf",
            "./node_modules/@expo-google-fonts/plus-jakarta-sans/600SemiBold/PlusJakartaSans_600SemiBold.ttf",
            "./node_modules/@expo-google-fonts/plus-jakarta-sans/700Bold/PlusJakartaSans_700Bold.ttf"
          ]
        }
      ],
      "expo-sqlite",
      [
        "expo-contacts",
        {
          "contactsPermission": "StoreFlick opens your contacts only when you tap Add from contacts, to fill in a khata customer or supplier."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#e2511e",
          "defaultChannel": "store_updates"
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "StoreFlick uses the microphone only when you tap the mic button, so you can type with your voice.",
          "speechRecognitionPermission": "StoreFlick turns your speech into text when you tap the mic button.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "StoreFlick uses your camera to photograph your products and to scan barcodes and QR codes when you make a bill.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "9339a23b-2818-49ee-99ee-36e30d1f9408"
      }
    },
    "owner": "siddiqkolimi"
  }
}
