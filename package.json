{
  "name": "@storekit/mobile",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "eslint app src --ext .js,.jsx",
    "test": "node scripts/verify-no-payment-code.mjs && node scripts/verify-routes.mjs && node scripts/verify-store-styles.mjs && node scripts/verify-variants.mjs && node scripts/verify-help.mjs && node scripts/verify-delivery.mjs && node scripts/verify-policies.mjs && node scripts/verify-states.mjs && node scripts/verify-notifications.mjs && node scripts/verify-format.mjs",
    "verify:compliance": "node scripts/verify-no-payment-code.mjs",
    "verify:endpoints": "node scripts/verify-endpoints.mjs",
    "bundle:check": "expo export --platform all --output-dir .expo/export-check",
    "doctor": "expo-doctor",
    "verify:routes": "node scripts/verify-routes.mjs",
    "verify:store-styles": "node scripts/verify-store-styles.mjs",
    "verify:variants": "node scripts/verify-variants.mjs",
    "eas-build-pre-install": "node scripts/check-build-env.mjs"
  },
  "dependencies": {
    "@expo-google-fonts/plus-jakarta-sans": "^0.4.2",
    "@expo-google-fonts/urbanist": "^0.4.2",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-community/datetimepicker": "8.4.4",
    "@storekit/shared": "*",
    "@storekit/validation": "*",
    "babel-preset-expo": "~54.0.10",
    "expo": "^54.0.37",
    "expo-asset": "~12.0.13",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.14",
    "expo-crypto": "~15.0.9",
    "expo-file-system": "~19.0.24",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-web-browser": "~15.0.11",
    "query-string": "^7.1.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-worklets": "0.5.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~19.1.10",
    "eslint": "^9.18.0",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.1.0"
  }
}
