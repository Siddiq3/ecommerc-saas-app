{
  "name": "@storekit/mobile",
  "version": "1.0.0",
  "private": true,
  "workspaces": ["packages/*"],
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "lint": "eslint app src --ext .js,.jsx",
    "test": "node scripts/verify-no-payment-code.mjs && node scripts/verify-routes.mjs && node scripts/verify-store-styles.mjs && node scripts/verify-variants.mjs",
    "verify:compliance": "node scripts/verify-no-payment-code.mjs",
    "verify:endpoints": "node scripts/verify-endpoints.mjs",
    "bundle:check": "expo export --platform all --output-dir .expo/export-check",
    "doctor": "expo-doctor",
    "verify:routes": "node scripts/verify-routes.mjs",
    "verify:store-styles": "node scripts/verify-store-styles.mjs",
    "verify:variants": "node scripts/verify-variants.mjs",
    "eas-build-pre-install": "node scripts/check-build-env.mjs"
  },
  "dependencies": {
    "@expo-google-fonts/plus-jakarta-sans": "^0.4.2",
    "@expo-google-fonts/urbanist": "^0.4.2",
    "@expo/vector-icons": "~14.0.4",
    "@react-native-community/datetimepicker": "8.2.0",
    "@storekit/shared": "*",
    "@storekit/validation": "*",
    "expo": "~52.0.27",
    "expo-asset": "~11.0.5",
    "expo-clipboard": "~7.0.1",
    "expo-constants": "~17.0.8",
    "expo-crypto": "~14.0.2",
    "expo-font": "~13.0.4",
    "expo-haptics": "~14.0.1",
    "expo-image-picker": "~16.0.4",
    "expo-linking": "~7.0.4",
    "expo-router": "~4.0.17",
    "expo-secure-store": "~14.0.1",
    "expo-status-bar": "~2.0.1",
    "expo-web-browser": "~14.0.2",
    "query-string": "^7.1.3",
    "react": "18.3.1",
    "react-native": "0.76.9",
    "react-native-reanimated": "~3.16.1",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~18.3.12",
    "eslint": "^9.18.0",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.1.0"
  }
}
