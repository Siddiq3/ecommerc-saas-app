{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://v1q2o37lv9.execute-api.ap-south-2.amazonaws.com",
        "EXPO_PUBLIC_STOREFRONT_URL": "https://storeflick.in",
        "EXPO_PUBLIC_WEB_URL": "https://storeflick.in"
      }
    },
    "simulator": {
      "extends": "preview",
      "ios": {
        "simulator": true
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.storeflick.in",
        "EXPO_PUBLIC_STOREFRONT_URL": "https://storeflick.in",
        "EXPO_PUBLIC_WEB_URL": "https://storeflick.in"
      }
    },
    "production-apk": {
      "extends": "production",
      "environment": "production",
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
